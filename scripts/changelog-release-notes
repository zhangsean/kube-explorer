#!/usr/bin/env bash

set -euo pipefail

version="${1:-}"
readme_path="${2:-README.md}"
output_path="${3:-dist/release-notes.md}"

if [[ ! "$version" =~ ^v[0-9]+\.[0-9]+\.[0-9]+([+-][0-9A-Za-z.-]+)?$ ]]; then
    echo "invalid release version: $version" >&2
    exit 1
fi

if [[ ! -f "$readme_path" ]]; then
    echo "changelog source not found: $readme_path" >&2
    exit 1
fi

mkdir -p "$(dirname "$output_path")"
temporary_output="${output_path}.tmp"
trap 'rm -f "$temporary_output"' EXIT

if ! awk -v version="$version" '
    /^### / {
        if (found) {
            exit
        }
        if ($2 == version) {
            found = 1
        }
    }
    found {
        print
    }
    END {
        if (!found) {
            exit 2
        }
    }
' "$readme_path" > "$temporary_output"; then
    echo "changelog section not found for $version in $readme_path" >&2
    exit 1
fi

if [[ ! -s "$temporary_output" ]]; then
    echo "changelog section is empty for $version in $readme_path" >&2
    exit 1
fi

mv "$temporary_output" "$output_path"
trap - EXIT
